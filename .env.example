# Copiez ce fichier en .env (ou saisissez ces valeurs dans votre hébergeur).
# NE METTEZ JAMAIS les vraies valeurs dans GitHub : ce dépôt est public.

# Clé API de la session WhatsApp (tableau de bord WasenderAPI > votre session > API Key)
WASENDER_API_KEY=

# Mot de passe pour accéder à la plateforme
APP_PASSWORD=

# Optionnel
# PORT=3000
# DRY_RUN=1                # simulation : rien n'est envoyé
# DEFAULT_COUNTRY_CODE=212 # indicatif ajouté aux numéros 06/07
# DATA_DIR=./data          # où sont stockées les campagnes
